# ==============================================================================
# Machine Copilot - Environment Configuration Template
# ==============================================================================

# Core Application Settings
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
UPLOAD_DIR=./uploads

# Mock Mode (Set to true to run 100% offline without paid API keys)
MOCK_EXTERNALS=true
MOCK_LLM_MODE=valid

# Database & Cache (Defaults configured for Docker Compose)
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
DATABASE_URL_TEST=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot_test
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=change-me-to-at-least-32-random-characters-secret
JWT_EXPIRES_HOURS=12

# LLM Synthesis (Cloudflare Workers AI Llama 3.1 8B or Mock)
LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.1

# Embeddings & RAG
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Voice Dispatch (Bolna AI Platform)
VOICE_PROVIDER=bolna
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEBHOOK_TOKEN=
BOLNA_WEBHOOK_ALLOWED_IPS=13.203.39.153
BOLNA_FROM_NUMBER=
BOLNA_MAX_CALL_SECONDS=90

# SMS & WhatsApp Escalation (Twilio)
NOTIFY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Cooldowns, Thresholds & Call Windows
COOLDOWN_S=1800
DAILY_CALL_CAP=5
MAX_CALL_ATTEMPTS=2
RETRY_DELAY_S=300
DEVICE_TELEMETRY_RATE_PER_MIN=6
CALL_TIMEZONE=Asia/Kolkata
CALL_WINDOW_START=08:00
CALL_WINDOW_END=20:00
ALLOW_HIGH_SEVERITY_OUT_OF_WINDOW=false
