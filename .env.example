APP_ENV=development
MOCK_EXTERNALS=true
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
DATABASE_URL_TEST=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-32-plus-random-bytes
JWT_EXPIRES_HOURS=12
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
EMBEDDING_BACKEND=hash
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
MOCK_LLM_MODE=valid
BOLNA_BASE_URL=
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEBHOOK_SECRET=change-me
BOLNA_SIGNATURE_HEADER=X-Bolna-Signature
NOTIFY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RETRY_DELAY_S=300
MAX_CALL_ATTEMPTS=2
DEVICE_TELEMETRY_RATE_PER_MIN=6
MACHINE_DAILY_CALL_CAP=5
COOLDOWN_S=1800
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

